# GLM-4.7 endpoint (OpenAI-compatible)
GLM_BASE_URL=
GLM_API_KEY=
GLM_MODEL=glm-4.7
GLM_VISION_MODEL=glm-4.6v
GLM_VISION_HTTP_TIMEOUT_SECONDS=120
WOLFRAM_APP_ID=

# Optional toggles
PYTHONUNBUFFERED=1
TB_OUTPUT_MODE=answer
TB_ENABLE_VISION=true
TB_ENABLE_LEAN=true
TB_ENABLE_SYMPY=true
TB_ENABLE_VERIFY=true
TB_ENABLE_GRAPH=true
TB_EMBED_GRAPH_ARTIFACT=true
TB_ENABLE_TOOLS=true
TB_ENABLE_WOLFRAM=true
TB_SHOW_TRACE=false
TB_TEACH_USE_GLM=false
TB_GLM_TUTOR_TIMEOUT_SECONDS=8
TB_VISION_TIMEOUT_SECONDS=45
TB_VISION_RETRY_TIMEOUT_SECONDS=90
TB_PARSE_TIMEOUT_SECONDS=6
TB_REPAIR_TIMEOUT_SECONDS=6
TB_TOOL_TIMEOUT_SECONDS=10
TB_WOLFRAM_TIMEOUT_SECONDS=7
